<div class="site-grid" id="dashboard-tiles" data-dashboard-view="tile">
{% for site in sites %}
    <article class="site-card" data-site data-site-id="{{ site['id'] }}" data-search="{{ site['name'] }} {{ site['host'] }} {{ site['repository'] }}" data-paused="{% if not site['enabled'] %}1{% else %}0{% endif %}" data-attention="{% if site['attention'] %}1{% else %}0{% endif %}">
        <div class="card-header"><div class="site-identity"><div class="site-monogram">{{ site['initial'] }}</div><div><h2><a href="{{ site['url'] }}" target="_blank" rel="noopener noreferrer">{{ site['name'] }}<svg><use href="/assets/icons.svg#external"></use></svg></a></h2><a class="site-host" href="{{ site['url'] }}" target="_blank" rel="noopener noreferrer">{{ site['host'] }}</a></div></div>{% include "dashboard-status.volt" %}</div>
        <div class="repo-line"><svg><use href="/assets/icons.svg#github"></use></svg><a href="https://github.com/{{ site['repository'] }}" target="_blank" rel="noopener noreferrer">{{ site['repository'] }}</a><span class="branch"><svg><use href="/assets/icons.svg#branch"></use></svg>{{ site['branch'] }}</span></div>
        <div class="version-panel"><div class="version-labels"><span>НА САЙТЕ</span><span>{% if site['comparison_mode'] == 'release' %}ПОСЛЕДНИЙ РЕЛИЗ{% else %}HEAD ВЕТКИ{% endif %}</span></div><div class="version-values"><code>{{ site['deployed_label'] }}</code><svg><use href="/assets/icons.svg#arrow"></use></svg><code>{{ site['latest_label'] }}</code></div>{% include "dashboard-comparison.volt" %}</div>
        <div class="site-metrics"><a href="https://github.com/{{ site['repository'] }}/issues" target="_blank" rel="noopener noreferrer"><svg><use href="/assets/icons.svg#issue"></use></svg>Issues<strong>{% if site['open_issues'] is defined and site['open_issues'] !== null %}{{ site['open_issues'] }}{% else %}—{% endif %}</strong></a><a href="https://github.com/{{ site['repository'] }}/pulls" target="_blank" rel="noopener noreferrer"><svg><use href="/assets/icons.svg#pr"></use></svg>PR<strong>{% if site['open_prs'] is defined and site['open_prs'] !== null %}{{ site['open_prs'] }}{% else %}—{% endif %}</strong></a><span><svg><use href="/assets/icons.svg#activity"></use></svg><strong>{% if site['response_time_ms'] is defined and site['response_time_ms'] !== null %}{{ site['response_time_ms'] }}{% else %}—{% endif %}</strong>мс</span></div>
        {% if site['last_error'] %}<details class="check-error"><summary>Есть ошибки проверки</summary><p>{{ site['last_error'] }}</p></details>{% endif %}
        <div class="card-footer"><span><svg><use href="/assets/icons.svg#clock"></use></svg>{{ site['checked_label'] }}{% if site['stale'] %}<b class="stale-label"> · Устарело</b>{% endif %}</span>{% include "dashboard-actions.volt" %}</div>
    </article>
{% endfor %}
    <a class="add-card" href="/sites/new"><span class="add-card-icon"><svg><use href="/assets/icons.svg#plus"></use></svg></span><strong>Ещё один сайт под контролем</strong><span>Добавьте сайт и его репозиторий</span><span class="add-card-link">Добавить сайт <svg><use href="/assets/icons.svg#arrow"></use></svg></span></a>
</div>
