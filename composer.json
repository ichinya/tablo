{
  "name": "ichinya/tablo",
  "description": "A small self-hosted dashboard for website health and deployment status",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "lib-curl": ">=7.55.0",
    "phalcon/phalcon": "^6.0@RC",
    "phalcon/volt": "^1.0@dev",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": { "classmap": ["app/"], "files": ["app/bootstrap.php"] },
  "require-dev": { "testo/testo": "^0.10.54" },
  "suggest": { "ext-pdo_mysql": "Required only when TABLO_DB_DRIVER=mysql or mariadb is explicitly selected" },
  "autoload-dev": { "psr-4": { "Tablo\\Tests\\": "tests/" } },
  "scripts": {
    "serve": "php -S 127.0.0.1:8087 -t public public/router.php",
    "check": "php bin/check.php",
    "test": "@php vendor/bin/testo run",
    "lint": "@php tools/lint.php",
    "analyze": "@php tools/analyze.php",
    "verify": "@php tools/verify.php",
    "verify:server": "@php tools/verify-server.php"
  },
  "config": { "sort-packages": true, "platform": { "php": "8.2.0" } }
}
