-- Administrative provisioning template, not an application/migration connection.
-- Review and materialize a PRIVATE copy with distinct generated passwords before use.
-- Never commit that copy. This catalog must exist before bin/database.php runs.
CREATE DATABASE tablo CHARACTER SET utf8mb4;
CREATE USER 'tablo_writer'@'%' IDENTIFIED BY '<private-writer-password>' REQUIRE SSL;
CREATE USER 'tablo_reader'@'%' IDENTIFIED BY '<private-reader-password>' REQUIRE SSL;
CREATE USER 'tablo_migrator'@'%' IDENTIFIED BY '<private-migrator-password>' REQUIRE SSL;

-- Migrator: this dedicated catalog only, including tables created during bootstrap.
-- No global, account, FILE, EXECUTE or database-creation authority is granted.
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, REFERENCES ON tablo.* TO 'tablo_migrator'@'%';

-- Apply the following grants AFTER initialization has created these exact tables.
GRANT SELECT, INSERT, UPDATE, DELETE ON tablo.users TO 'tablo_writer'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE ON tablo.git_tokens TO 'tablo_writer'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE ON tablo.sites TO 'tablo_writer'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE ON tablo.login_limits TO 'tablo_writer'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE ON tablo.github_cooldowns TO 'tablo_writer'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE ON tablo.installation_settings TO 'tablo_writer'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE ON tablo.worker_runtime TO 'tablo_writer'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE ON tablo.worker_progress TO 'tablo_writer'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE ON tablo.check_history TO 'tablo_writer'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE ON tablo.incidents TO 'tablo_writer'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE ON tablo.incident_checkpoints TO 'tablo_writer'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE ON tablo.notification_settings TO 'tablo_writer'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE ON tablo.notification_checkpoints TO 'tablo_writer'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE ON tablo.notification_slots TO 'tablo_writer'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE ON tablo.read_api_token TO 'tablo_writer'@'%';
GRANT SELECT ON tablo.tablo_database_state TO 'tablo_writer'@'%';
GRANT UPDATE (committed_history_high_watermark) ON tablo.tablo_database_state TO 'tablo_writer'@'%';
GRANT SELECT ON tablo.tablo_migration_journal TO 'tablo_writer'@'%';
GRANT SELECT, UPDATE ON tablo.tablo_writer_guard TO 'tablo_writer'@'%';

-- Reader: explicit bounded projection/authentication columns, no credential ciphers.
GRANT SELECT (id,password_hash) ON tablo.users TO 'tablo_reader'@'%';
GRANT SELECT ON tablo.read_api_token TO 'tablo_reader'@'%';
GRANT SELECT (id,format,logical_version,layout_checksum,phase,installation_id,committed_history_high_watermark)
    ON tablo.tablo_database_state TO 'tablo_reader'@'%';
GRANT SELECT (id,config_revision,name,url,provider,repository,branch,enabled,sort_order,
    online,health_http_status,response_time_ms,open_issues,open_prs,health_path,version_path,
    comparison_mode,health_check_mode,created_at,updated_at,checked_at,health_error_code,
    deployed_version,latest_release,deployed_commit,latest_commit)
    ON tablo.sites TO 'tablo_reader'@'%';
-- In particular: no CREATE TEMPORARY TABLES, DDL, DML, FILE, EXECUTE or admin/global grants.
