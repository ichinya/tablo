{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tablo:read-api:v1",
  "title": "Tablo external read API v1",
  "description": "Conservative authenticated external DTO. Canonical int64 identity strings, UTC seconds, actual nullable observations. No private raw version labels or credential fields. Breaking changes require v2.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "generated_at",
        "data",
        "page"
      ],
      "properties": {
        "api_version": {
          "const": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/site"
          }
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "next_after_id"
          ],
          "properties": {
            "next_after_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "generated_at",
        "data"
      ],
      "properties": {
        "api_version": {
          "const": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "data": {
          "$ref": "#/$defs/site"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "error"
      ],
      "properties": {
        "api_version": {
          "const": 1
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "unauthorized"
            },
            "message": {
              "const": "Authentication required."
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "error"
      ],
      "properties": {
        "api_version": {
          "const": 1
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "invalid_parameter"
            },
            "message": {
              "const": "Invalid request."
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "error"
      ],
      "properties": {
        "api_version": {
          "const": 1
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "not_found"
            },
            "message": {
              "const": "Not found."
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "error"
      ],
      "properties": {
        "api_version": {
          "const": 1
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "method_not_allowed"
            },
            "message": {
              "const": "Method not allowed."
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "error"
      ],
      "properties": {
        "api_version": {
          "const": 1
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "unavailable"
            },
            "message": {
              "const": "Service unavailable."
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "config_revision",
        "name",
        "origin",
        "provider",
        "repository",
        "branch",
        "enabled",
        "sort_order",
        "comparison_mode",
        "health_check_mode",
        "health_target",
        "tracks_version",
        "created_at",
        "updated_at",
        "latest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$"
        },
        "config_revision": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807|0)$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "origin": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 300,
              "pattern": "^https?://[^/?#@]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "const": "github"
        },
        "repository": {
          "type": "string",
          "maxLength": 140,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "enabled": {
          "type": "boolean"
        },
        "sort_order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "comparison_mode": {
          "enum": [
            "release",
            "branch"
          ]
        },
        "health_check_mode": {
          "enum": [
            "http",
            "json"
          ]
        },
        "health_target": {
          "enum": [
            "homepage",
            "endpoint"
          ]
        },
        "tracks_version": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "latest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "checked_at",
            "freshness",
            "online",
            "health_error_code",
            "health_http_status",
            "response_time_ms",
            "open_issues",
            "open_prs",
            "comparison"
          ],
          "properties": {
            "status": {
              "enum": [
                "paused",
                "unknown",
                "partial",
                "complete"
              ]
            },
            "checked_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "freshness": {
              "enum": [
                "never_checked",
                "clock_invalid",
                "fresh",
                "stale"
              ]
            },
            "online": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "health_error_code": {
              "anyOf": [
                {
                  "enum": [
                    "timeout",
                    "refused",
                    "dns",
                    "ssrf",
                    "tls",
                    "size",
                    "invalid-response",
                    "invalid-url",
                    "redirect-location-missing",
                    "redirect-location-invalid",
                    "redirect-origin",
                    "redirect-cycle",
                    "redirect-limit",
                    "network",
                    "check-error",
                    "json-condition",
                    "http"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "health_http_status": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                {
                  "type": "null"
                }
              ]
            },
            "response_time_ms": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            },
            "open_issues": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            },
            "open_prs": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            },
            "comparison": {
              "enum": [
                "not_tracked",
                "unknown",
                "current",
                "update_available",
                "ahead",
                "different"
              ]
            }
          }
        }
      }
    }
  }
}
