# PHP loads this file from the project root. Existing process variables take priority.
TABLO_DB=storage/tablo.sqlite
TABLO_ALLOW_PRIVATE_NETWORK=0
TABLO_COOKIE_SECURE=0
TABLO_HISTORY_RETENTION_DAYS=30
# Exact proxy IPs only; empty disables application forwarding trust.
TABLO_TRUSTED_PROXIES=
# Optional existing raw 32-byte read-only file; empty retains the adjacent legacy key.
# Relative paths use the project root. This is a path, never the key contents.
TABLO_TOKEN_KEY_FILE=

# SQLite remains the default. Clear TABLO_DB before explicitly selecting a server.
TABLO_DB_DRIVER=sqlite
# Server-only settings must be absent or empty in SQLite mode.
# TABLO_DB_DRIVER=mysql
# TABLO_DB=
# TABLO_DB_NAME=tablo
# TABLO_DB_HOST=database.example.invalid
# TABLO_DB_PORT=3306
# TABLO_DB_USER=tablo_writer
# TABLO_DB_PASSWORD=provided-outside-source
# TABLO_DB_READ_USER=tablo_reader
# TABLO_DB_READ_PASSWORD=provided-outside-source
# TABLO_DB_MIGRATE_USER=tablo_migrator
# TABLO_DB_MIGRATE_PASSWORD=provided-outside-source
# TABLO_DB_TLS=verify
# TABLO_DB_TLS_CA=/run/secrets/database-ca.pem
# Optional paired mutual-TLS files:
# TABLO_DB_TLS_CERT=/run/secrets/database-client.pem
# TABLO_DB_TLS_KEY=/run/secrets/database-client.key
# A Unix socket replaces HOST/PORT and all TLS fields, never combines with them:
# TABLO_DB_SOCKET=/run/mysqld/mysqld.sock
# TABLO_DB_TLS=local
